{
  "name": "deepseek-harness-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "preview": "node tools/serve.mjs --production",
    "baseline": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node tools/prerender.mjs",
    "build:netlify": "npm run build && node tools/check-build.mjs",
    "test": "vitest run",
    "test:http": "node --test tools/serve.test.mjs",
    "check:baseline": "node tools/netlify-build.mjs",
    "audit": "node tools/audit.mjs",
    "diff:screenshots": "node tools/pixel-diff.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
